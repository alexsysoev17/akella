{
  "name": "motion-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "create-project": "node --import tsx apps/scene-validator/src/cli.ts create-project",
    "validate": "node --import tsx apps/scene-validator/src/cli.ts validate",
    "dev": "node --import tsx apps/scene-validator/src/cli.ts dev",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "build": "tsc && node scripts/build-ui.mjs",
    "test": "node --import tsx --test apps/scene-validator/tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "projects": "node --import tsx apps/scene-validator/src/cli.ts projects",
    "import": "node --import tsx apps/scene-validator/src/cli.ts import",
    "pretest": "node scripts/build-ui.mjs",
    "predev": "node scripts/build-ui.mjs",
    "eval:semantic": "node --import tsx scripts/eval-semantic.ts",
    "eval:harness": "node --import tsx scripts/harness-cli.ts eval",
    "harness": "node --import tsx scripts/harness-cli.ts",
    "render:object": "node --import tsx scripts/render-object.ts",
    "verify:rendering": "node --import tsx scripts/verify-rendering.ts",
    "compare:ae": "node --import tsx scripts/compare-ae-reference.ts",
    "eval:core-inertia": "node --import tsx scripts/eval-core-inertia.ts",
    "benchmark:quick": "node --import tsx scripts/benchmark.ts --cases NEW_09_COMPOUND,NEW_10_GROUP,EDIT_03_ADD_FADE,CONTEXT_01,EDGE_03_MISSING_FADE",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "benchmark:live": "node --import tsx scripts/benchmark.ts --live",
    "benchmark:replay": "node --import tsx scripts/replay-agent-run.ts",
    "benchmark:video": "node --import tsx scripts/benchmark.ts --video --cases WORKFLOW_04_EIGHT_OBJECTS,WORKFLOW_05_PATH_SEQUENCE",
    "benchmark:report": "node --import tsx scripts/benchmark-report.ts"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.162.1",
    "ffmpeg-static": "5.3.0",
    "jszip": "3.10.1",
    "playwright": "1.62.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
